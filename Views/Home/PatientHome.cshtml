@model GrapheneTrace.Models.Patient.PatientHomeViewModel
@using System.Text.Json
@using Microsoft.AspNetCore.Identity
@using GrapheneTrace.Areas.Identity.Data
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Patient Home";

    var currentUserIdString = UserManager.GetUserId(User);
    int.TryParse(currentUserIdString, out var currentUserId);
}


<div class="container-fluid px-5">
    <div class="row align-items-start">
        <div class="col-lg-8 col-md-7 mb-4">
            <h3 class="mb-3 fw-semibold">Your Pressure Map</h3>

            @if (Model.AllHeatmapGrids != null && Model.AllHeatmapGrids.Any())
            {
                <p class="text-muted mb-3">
                    Showing data from:
                    <strong>@Model.HeatmapTimestamp?.ToString("dd MMMM yyyy")</strong>
                </p>

                <div class="card shadow-sm p-3" style="width: 100%; max-width: 700px;">
                    <div class="card-body">
                        <canvas id="heatmapCanvas"
                                width="640"
                                height="640"
                                style="border: 1px solid #ccc; background-color: #f9f9f9; display: block; margin: 0 auto 1rem auto;">
                        </canvas>

                        <div class="mt-3">
                            <h6 class="fw-bold">Chunk Metrics</h6>
                            <div class="row small">
                                <div class="col-6">
                                    <p class="mb-1">Peak Pressure: <span id="peakPressure">0</span></p>
                                    <p class="mb-1">Average Pressure: <span id="averagePressure">0</span></p>
                                    <p class="mb-1">Minimum Pressure: <span id="minPressure">0</span></p>
                                </div>
                                <div class="col-6">
                                    <p class="mb-1">Maximum Pressure: <span id="maxPressure">0</span></p>
                                    <p class="mb-1">Contact Area: <span id="contactArea">0</span>%</p>
                                </div>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <div class="d-flex align-items-center">
                            <button id="playPauseBtn" class="btn btn-primary me-3 px-3">Play</button>
                            <input type="range"
                                   id="chunkSlider"
                                   class="form-range flex-grow-1"
                                   min="0"
                                   max="@(Model.AllHeatmapGrids.Count - 1)"
                                   value="0" />
                        </div>

                        <div class="text-center mt-2 small text-muted">
                            <span id="chunkIndicator">Chunk 1 / @Model.AllHeatmapGrids.Count</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3">
                    <strong>No heatmap data found.</strong><br />
                    It looks like you don't have any sensor records yet, or the latest record has no heatmap.
                </div>
            }
        </div>

        <div class="col-lg-4 col-md-5">
            <div class="card shadow-sm mb-4" style="margin-top: 5.5rem;">
                <div class="card-body">
                    <h4 class="card-title mb-3 fw-semibold">Your Data History</h4>
                    <p class="text-muted small">You have @Model.AllSensorData.Count record(s) on file.</p>

                    <div class="list-group small" style="max-height: 250px; overflow-y: auto;">
                        @if (Model.AllSensorData.Any())
                        {
                            @foreach (var record in Model.AllSensorData)
                            {
                                <a asp-action="PatientHome"
                                   asp-route-dataId="@record.DataId"
                                   class="list-group-item list-group-item-action @(record.Timestamp == Model.HeatmapTimestamp ? "active" : "")">
                                    Data from @record.Timestamp.ToString("dd MMMM yyyy")
                                </a>
                            }
                        }
                        else
                        {
                            <div class="list-group-item">No records found.</div>
                        }
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3 fw-semibold">Add Comment</h5>

                    <form asp-controller="Feedback" asp-action="AddFeedback" method="post">
                        <div class="mb-3">
                            <label for="commentsChunkId" class="form-label">Chunk ID</label>
                            <input id="commentsChunkId" name="ChunkId" type="number" class="form-control" min="0" max="4278" step="1"/>
                        </div>

                        <div class="mb-3">
                            <label for="commentText" class="form-label">Comment</label>
                            <textarea id="commentText" name="Text" class="form-control" rows="4" placeholder="Write your comments here..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Submit</button>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3 fw-semibold">Comments</h5>

                    @if (Model.AllFeedback != null && Model.AllFeedback.Any())
                    {
                        <ul class="list-group list-group-flush small">
                            @foreach (var f in Model.AllFeedback)
                            {
                                <li class="list-group-item">
                                    <div class="fw-bold text-muted">@f.TimeStamp.ToLocalTime().ToString("g")</div>
                                    <div>@f.Comment</div>
                                    @if (f.HeatmapChunk != null)
                                    {
                                        <div class="text-muted small mt-1">
                                            Related to chunk: <strong>@f.HeatmapChunk.ChunkId</strong>
                                        </div>
                                    }
              
                                    @if (f.UserId == currentUserId)
                                    {
                                        <form asp-controller="Feedback" asp-action="DeleteFeedback" method="post" class="mt-2">
                                            <input type="hidden" name="feedbackId" value="@f.FeedbackId" />
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No feedback submitted yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>




@section Scripts {

    <script type="module">
        import { initHeatmap } from '/js/patientHome.js';

        const allGridsData = @Html.Raw(JsonSerializer.Serialize(Model.AllHeatmapGrids));
        const allMetricsData = @Html.Raw(JsonSerializer.Serialize(Model.AllMetrics));

        initHeatmap(allGridsData, allMetricsData);
        
    </script>
}


