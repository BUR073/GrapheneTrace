@model GrapheneTrace.Models.Patient.PatientHomeViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Patient Home";
}

<div class="row">
    <div class="col-md-8">
        <h3>Your Latest Pressure Map</h3>

        @if (Model.AllHeatmapGrids != null && Model.AllHeatmapGrids.Any())
        {
            <p>
                Showing data from:
                <strong>@Model.HeatmapTimestamp?.ToString("dd MMMM yyyy")</strong>
            </p>

            <canvas id="heatmapCanvas"
                    width="320"
                    height="320"
                    style="border: 1px solid #ccc; background-color: #f9f9f9;"></canvas>

            <div class="mt-3">
                <div class="d-flex align-items-center">
                    <button id="playPauseBtn" class="btn btn-primary me-2">Play</button>
                    <input type="range"
                           id="chunkSlider"
                           class="form-range"
                           min="0"
                           max="@(Model.AllHeatmapGrids.Count - 1)"
                           value="0" />
                </div>
                <div class="text-center mt-1">
                    <span id="chunkIndicator">Chunk 1 / @Model.AllHeatmapGrids.Count</span>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3">
                <strong>No heatmap data found.</strong>
                It looks like you don't have any sensor records yet, or the latest record has no heatmap.
            </div>
        }
    </div>
    
    <div class="col-md-4">
        <h4>Your Data History</h4>
        <p>You have @Model.AllSensorData.Count record(s) on file.</p>

        <div class="list-group" style="max-height: 400px; overflow-y: auto;">
            @if (Model.AllSensorData.Any())
            {
                @foreach (var record in Model.AllSensorData)
                {
                    <a asp-action="PatientHome"
                       asp-route-dataId="@record.DataId"
                       class="list-group-item list-group-item-action @(record.Timestamp == Model.HeatmapTimestamp ? "active" : "")">
                        Data from @record.Timestamp.ToString("dd MMMM yyyy")
                    </a>
                }
            }
            else
            {
                <div class="list-group-item">No records found.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const allGridsData = @Html.Raw(JsonSerializer.Serialize(Model.AllHeatmapGrids));

        if (allGridsData && allGridsData.length > 0) {
            const canvas = document.getElementById('heatmapCanvas');
            const ctx = canvas.getContext('2d');
            const slider = document.getElementById('chunkSlider');
            const playPauseBtn = document.getElementById('playPauseBtn');
            const chunkIndicator = document.getElementById('chunkIndicator');

            const cellSize = 10;
            let isPlaying = false;
            let currentChunkIndex = 0;
            let playInterval;

            function drawGrid(chunkIndex) {
                if (chunkIndex >= allGridsData.length) return;

                const gridData = allGridsData[chunkIndex];
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                for (let row = 0; row < gridData.length; row++) {
                    for (let col = 0; col < gridData[row].length; col++) {
                        const value = gridData[row][col];
                        ctx.fillStyle = getColorForValue(value);
                        ctx.fillRect(col * cellSize, row * cellSize, cellSize, cellSize);
                    }
                }

                updateUI(chunkIndex);
            }

            function getColorForValue(value) {
                if (value === 0) return "#f0f0f0";
                const hue = 240 - (value / 255) * 240;
                return `hsl(${hue}, 100%, 50%)`;
            }

            function updateUI(chunkIndex) {
                slider.value = chunkIndex;
                chunkIndicator.textContent = `Chunk ${chunkIndex + 1} / ${allGridsData.length}`;
            }

            function playNextChunk() {
                currentChunkIndex++;
                if (currentChunkIndex >= allGridsData.length) {
                    currentChunkIndex = 0;
                }
                drawGrid(currentChunkIndex);
            }

            function startPlayback() {
                isPlaying = true;
                playPauseBtn.textContent = "Pause";
                playInterval = setInterval(playNextChunk, 100);
            }

            function stopPlayback() {
                isPlaying = false;
                playPauseBtn.textContent = "Play";
                clearInterval(playInterval);
            }

            playPauseBtn.addEventListener('click', () => {
                if (isPlaying) {
                    stopPlayback();
                } else {
                    startPlayback();
                }
            });

            slider.addEventListener('input', (e) => {
                if (isPlaying) stopPlayback();
                currentChunkIndex = parseInt(e.target.value, 10);
                drawGrid(currentChunkIndex);
            });

            drawGrid(0);
        }
    </script>
}
