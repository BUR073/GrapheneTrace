@model GrapheneTrace.Models.Admin.AdminHomeViewModel
@using Microsoft.AspNetCore.Identity
@using GrapheneTrace.Areas.Identity.Data
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Admin Dashboard";
    var currentUserIdString = UserManager.GetUserId(User);
    int.TryParse(currentUserIdString, out var currentUserId);
}

<h1>@ViewData["Title"]</h1>

<div class="d-flex justify-content-between align-items-center mb-4">
    
    <h2 class="m-0">User Accounts</h2>

    <div class="d-flex align-items-center">
        
        <form asp-controller="Home" asp-action="AdminHome" method="get" class="me-2">
            <div class="input-group">
                <input type="text" name="searchString" class="form-control" placeholder="Search by ID, email, or role..." value="@ViewData["CurrentFilter"]" />
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        <a class="btn btn-primary" asp-controller="Admin" asp-action="CreateUser">Create New User</a>

    </div>
</div>
<table class="table table-striped">
    <thead>
    <tr>
        <th>User ID</th>
        <th>Role</th>
        <th>Name</th>
        <th>User Email</th>
        <th>Date of Birth</th>
        <th style="width: 300px;">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.Id</td>
            <td>@string.Join(", ", user.Roles)</td>
            <td>@user.Name</td>
            <td>@user.Email</td>
            <td>@user.DateOfBirth.ToShortDateString()</td>
            
            <td class="action-button-group">

                <div class="action-slot">
                    @if (user.Roles.Contains("Patient"))
                    {
                        <a class="btn btn-primary btn-sm w-100" asp-controller="Admin" asp-action="ManageUser" asp-route-id="@user.Id">Manage Patient</a>
                    }
                    @if (user.Roles.Contains("Clinician"))
                    {
                        <a class="btn btn-primary btn-sm w-100" asp-controller="Admin" asp-action="ManageClinician" asp-route-id="@user.Id">Manage Clinician</a>
                    }
                </div>

                <div class="action-slot-sm">
                    <a class="btn btn-secondary btn-sm w-100" asp-controller="Admin" asp-action="EditUser" asp-route-id="@user.Id">Edit</a>
                </div>

                <div class="action-slot-sm">
                    @if (user.Id != currentUserId)
                    {
                        <a class="btn btn-danger btn-sm w-100" asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.Id">Delete</a>
                    }
                </div>

            </td>
        </tr>
    }
    </tbody>
</table>