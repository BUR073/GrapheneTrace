@model IEnumerable<GrapheneTrace.Models.Database.SensorData>
@using System.Text.Json; 

@{
ViewData["Title"] = "User Home";
var allHeatmapGrids = ViewBag.AllHeatmapGrids as List<List<List<int>>>;
var heatmapTimestamp = ViewBag.HeatmapTimestamp as DateTime?;
}

<div class="row">
<div class="col-md-8">
<h3>Your Latest Pressure Map</h3>

    @if (allHeatmapGrids != null && allHeatmapGrids.Count > 0)
    {
        <p>Showing data from: <strong>@heatmapTimestamp?.ToString("dd MMMM yyyy")</strong></p>
        
        <canvas id="heatmapCanvas" width="320" height="320" style="border: 1px solid #ccc; background-color: #f9f9f9;"></canvas>
        
        <div class="mt-3">
            <div class="d-flex align-items-center">
                <button id="playPauseBtn" class="btn btn-primary me-2">Play</button>
                <input type="range" id="chunkSlider" class="form-range" min="0" max="@(allHeatmapGrids.Count - 1)" value="0">
            </div>
            <div class="text-center mt-1">
                <span id="chunkIndicator">Chunk 1 / @allHeatmapGrids.Count</span>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <strong>No heatmap data found.</strong> It looks like you don't have any sensor records yet, or the latest record has no heatmap.
        </div>
    }
</div>

<div class="col-md-4">
    <h4>Your Data History</h4>
    <p>You have @Model.Count() record(s) on file.</p>
    <div class="list-group" style="max-height: 400px; overflow-y: auto;">
        @if (Model.Any())
        {
            @foreach (var record in Model)
            {
                <a asp-action="UserHome" asp-route-dataId="@record.DataId" class="list-group-item list-group-item-action @(record.Timestamp == heatmapTimestamp ? "active" : "")">
                    Data from @record.Timestamp.ToString("dd MMMM yyyy")
                </a>
            }
        }
        else
        {
            <div class="list-group-item">No records found.</div>
        }
    </div>
</div>


</div>


@section Scripts {
<script>
var allGridsData = @Html.Raw(Json.Serialize(allHeatmapGrids));

    if (allGridsData && allGridsData.length > 0) {
        
        var canvas = document.getElementById('heatmapCanvas');
        var ctx = canvas.getContext('2d');
        var slider = document.getElementById('chunkSlider');
        var playPauseBtn = document.getElementById('playPauseBtn');
        var chunkIndicator = document.getElementById('chunkIndicator');

        const cellSize = 10; 
        var isPlaying = false;
        var currentChunkIndex = 0;
        var playInterval;
        
        function drawGrid(chunkIndex) {
            if (chunkIndex >= allGridsData.length) return;
            
            var gridData = allGridsData[chunkIndex];
            
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            for (var row = 0; row < gridData.length; row++) {
                for (var col = 0; col < gridData[row].length; col++) {
                    var value = gridData[row][col];
                    ctx.fillStyle = getColorForValue(value);
                    ctx.fillRect(col * cellSize, row * cellSize, cellSize, cellSize);
                }
            }
            
            updateUI(chunkIndex);
        }

        function getColorForValue(value) {
            if (value === 0) return "#f0f0f0"; 
            var hue = 240 - (value / 255) * 240; 
            return `hsl(${hue}, 100%, 50%)`;
        }
        
        function updateUI(chunkIndex) {
            slider.value = chunkIndex;
            chunkIndicator.textContent = `Chunk ${chunkIndex + 1} / ${allGridsData.length}`;
        }

        function playNextChunk() {
            currentChunkIndex++;
            if (currentChunkIndex >= allGridsData.length) {
                currentChunkIndex = 0; 
            }
            drawGrid(currentChunkIndex);
        }

        function startPlayback() {
            isPlaying = true;
            playPauseBtn.textContent = "Pause";
            playInterval = setInterval(playNextChunk, 100); 
        }

        function stopPlayback() {
            isPlaying = false;
            playPauseBtn.textContent = "Play";
            clearInterval(playInterval);
        }

        playPauseBtn.addEventListener('click', () => {
            if (isPlaying) {
                stopPlayback();
            } else {
                startPlayback();
            }
        });

        slider.addEventListener('input', (e) => {
            if (isPlaying) {
                stopPlayback(); 
            }
            currentChunkIndex = parseInt(e.target.value, 10);
            drawGrid(currentChunkIndex);
        });
        
        drawGrid(0);
    }
</script>


}