@* SID: 2408078 *@
@using GrapheneTrace.Enums
@model GrapheneTrace.Models.Admin.ManageLinksViewModel

@{
    var primaryRole = Model.PrimaryUserRole;
    var linkRole = (primaryRole == UserType.Patient) ? "Clinicians" : "Patients";
    ViewData["Title"] = $"Manage {primaryRole}: {Model.PrimaryUserName}";
}

<h1>@ViewData["Title"]</h1>
<hr />

<form id="manage-links-form"
      asp-action="ManageUser" 
      method="post"
      onsubmit="selectAllAssigned()">

    <input type="hidden" asp-for="PrimaryUserId" />
    <input type="hidden" asp-for="PrimaryUserRole" />

    <div class="row">
        
        <div class="col-5">
            <label class="form-label fw-bold">Available @linkRole</label>
            <select id="available-list" class="form-control" multiple style="height: 400px;">
                @foreach (var item in Model.AvailableLinks)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
        </div>

        <div class="col-2 d-flex flex-column align-items-center justify-content-center gap-2">
            <button type="button" id="btn-assign" class="btn btn-outline-success w-75">&gt;&gt;</button>
            <button type="button" id="btn-unassign" class="btn btn-outline-danger w-75">&lt;&lt;</button>
        </div>

        <div class="col-5">
            <label class="form-label fw-bold">Currently Assigned to @Model.PrimaryUserName</label>
            <select id="assigned-list" 
                    asp-for="SelectedLinkIds" 
                    asp-items="Model.AssignedLinks" 
                    class="form-control" 
                    multiple 
                    style="height: 400px;"></select>
        </div>
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Save Changes" class="btn btn-primary" />
        <a asp-controller="Home" asp-action="AdminHome" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/manageLinks.js"></script>
}